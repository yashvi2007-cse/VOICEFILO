# VOICEFILO 1.0 Environment Configuration

# Supabase Configuration (Optional for Cloud Sync; Local IndexedDB / Offline works out-of-the-box!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Gemini API Key for Natural Language Intent Parsing (Never exposed to frontend client)
# Note: VOICEFILO contains a complete, robust Indian deterministic intent & amount parser,
# so the app functions 100% reliably even without a Gemini API key!
GEMINI_API_KEY=
